# Language model: azure (upstream-compatible default), codex, or local.
CHEMEAGLE_LLM_PROVIDER=codex
CHEMEAGLE_LLM_MODEL=
# Codex inactivity window for ordinary turns; activity resets the window.
CHEMEAGLE_LLM_TIMEOUT=240
# Final Data Structure Agent keeps the upstream-compatible ten-minute window.
CHEMEAGLE_LLM_SYNTHESIS_TIMEOUT=600
# Time spent inside a dynamic tool is measured separately.
CHEMEAGLE_LLM_TOOL_TIMEOUT=3600
# Hard-clamped to 1..3. A timeout starts a fresh attempt with the same input.
CHEMEAGLE_LLM_MAX_ATTEMPTS=3

# Codex App Server uses the current Codex subscription login, not an API key.
CODEX_BIN=codex
CODEX_MODEL=
CHEMEAGLE_CODEX_CWD=
CHEMEAGLE_CODEX_MIN_VERSION=0.146.0

# Azure OpenAI (needed only when CHEMEAGLE_LLM_PROVIDER=azure).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional OpenAI-compatible local server.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3-VL-32B-Instruct
VLLM_SUPPORTS_TOOLS=true
VLLM_SUPPORTS_RESPONSE_FORMAT=true
VLLM_SUPPORTS_RESPONSE_FORMAT_WITH_TOOLS=false
VLLM_SUPPORTS_JSON_SCHEMA=false

# Vision execution: local, ssh, or slurm-ssh. This is independent of the LLM.
CHEMEAGLE_VISION_PROVIDER=local
CHEMEAGLE_VISION_DEVICE=auto
# "auto" preserves upstream placement for ChemRxnExtractor.
CHEMEAGLE_VISION_CHEMRXN_DEVICE=auto
CHEMEAGLE_VISION_TIMEOUT=600
CHEMEAGLE_VISION_STARTUP_TIMEOUT=1800
# Hard-clamped to 1..3 for transport/process/timeout failures.
CHEMEAGLE_VISION_MAX_ATTEMPTS=3
CHEMEAGLE_VISION_OFFLINE=false
CHEMEAGLE_VISION_MODEL_DIR=

# Persistent SSH worker, for example the RTX 3060 Ti WSL machine.
CHEMEAGLE_VISION_SSH_HOST=
CHEMEAGLE_VISION_SSH_CONFIG=~/.ssh/config
CHEMEAGLE_VISION_REMOTE_DIR=
CHEMEAGLE_VISION_REMOTE_PYTHON=python3

# Slurm-over-SSH worker. Leave scheduler-specific fields blank when unused.
CHEMEAGLE_VISION_SLURM_ACCOUNT=
CHEMEAGLE_VISION_SLURM_QOS=
CHEMEAGLE_VISION_SLURM_RESERVATION=
CHEMEAGLE_VISION_SLURM_PARTITION=
# Optional internal submit host, e.g. sandbox, to keep srun off the login node.
CHEMEAGLE_VISION_SLURM_SUBMIT_HOST=
CHEMEAGLE_VISION_SLURM_GPU_TYPE=L40S
CHEMEAGLE_VISION_SLURM_GPUS=1
CHEMEAGLE_VISION_SLURM_CPUS=8
CHEMEAGLE_VISION_SLURM_MEMORY=24G
CHEMEAGLE_VISION_SLURM_TIME=08:00:00
# Local file receiving remote stderr; JSON protocol data stays on stdout.
CHEMEAGLE_VISION_REMOTE_LOG=
