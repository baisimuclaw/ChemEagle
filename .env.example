# Backend selection: azure (backward-compatible default), codex, or local
CHEMEAGLE_LLM_PROVIDER=codex
CHEMEAGLE_LLM_MODEL=
CHEMEAGLE_LLM_TIMEOUT=180
CHEMEAGLE_LLM_MAX_RETRIES=3

# Azure OpenAI. Legacy aliases API_KEY/AZURE_ENDPOINT/API_VERSION remain supported.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Codex App Server. Authentication is managed by `codex`; no API key belongs here.
CODEX_BIN=codex
CODEX_MODEL=
CHEMEAGLE_CODEX_CWD=
CHEMEAGLE_CODEX_MIN_VERSION=0.146.0

# Local vLLM/Ollama OpenAI-compatible server
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3-VL-32B-Instruct-AWQ
VLLM_SUPPORTS_TOOLS=true
VLLM_SUPPORTS_RESPONSE_FORMAT=true
VLLM_SUPPORTS_RESPONSE_FORMAT_WITH_TOOLS=false
VLLM_SUPPORTS_JSON_SCHEMA=false
