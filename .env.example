# Backend selection: azure (backward-compatible default), codex, or local
CHEMEAGLE_LLM_PROVIDER=codex
CHEMEAGLE_LLM_MODEL=
CHEMEAGLE_LLM_TIMEOUT=180
CHEMEAGLE_LLM_MAX_RETRIES=3

# Azure OpenAI. Legacy aliases API_KEY/AZURE_ENDPOINT/API_VERSION remain supported.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Codex App Server. Authentication is managed by `codex`; no API key belongs here.
CODEX_BIN=codex
CODEX_MODEL=
CHEMEAGLE_CODEX_CWD=
CHEMEAGLE_CODEX_MIN_VERSION=0.146.0

# Local vLLM/Ollama OpenAI-compatible server
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3-VL-32B-Instruct-AWQ
VLLM_SUPPORTS_TOOLS=true
VLLM_SUPPORTS_RESPONSE_FORMAT=true
VLLM_SUPPORTS_RESPONSE_FORMAT_WITH_TOOLS=false
VLLM_SUPPORTS_JSON_SCHEMA=false

# Chemical-vision execution: local, ssh, or slurm-ssh. This is independent of
# CHEMEAGLE_LLM_PROVIDER; Codex can stay local while vision runs on a remote GPU.
CHEMEAGLE_VISION_PROVIDER=local
CHEMEAGLE_VISION_DEVICE=auto
CHEMEAGLE_VISION_TIMEOUT=600
CHEMEAGLE_VISION_STARTUP_TIMEOUT=1800
CHEMEAGLE_VISION_OFFLINE=false
CHEMEAGLE_VISION_MODEL_DIR=

# Persistent SSH worker (for example an RTX 3060 Ti WSL machine).
CHEMEAGLE_VISION_SSH_HOST=
CHEMEAGLE_VISION_SSH_CONFIG=~/.ssh/config
CHEMEAGLE_VISION_REMOTE_DIR=
CHEMEAGLE_VISION_REMOTE_PYTHON=python3

# Slurm-over-SSH worker. Leave unused fields blank for a plain SSH worker.
CHEMEAGLE_VISION_SLURM_ACCOUNT=
CHEMEAGLE_VISION_SLURM_QOS=
CHEMEAGLE_VISION_SLURM_RESERVATION=
CHEMEAGLE_VISION_SLURM_PARTITION=
# Optional internal host from which long-running srun clients must be launched.
CHEMEAGLE_VISION_SLURM_SUBMIT_HOST=
CHEMEAGLE_VISION_SLURM_GPU_TYPE=L40S
CHEMEAGLE_VISION_SLURM_GPUS=1
CHEMEAGLE_VISION_SLURM_CPUS=8
CHEMEAGLE_VISION_SLURM_MEMORY=64G
CHEMEAGLE_VISION_SLURM_TIME=08:00:00
